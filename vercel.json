{
  "version": 2,
  "functions": {
    "api/product-page.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "routes": [
    {
      "src": "^/index\\.html$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/.*\\.apk$",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"GG-SHOPPING.apk\"",
        "Cache-Control": "public, max-age=300"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/manifest\\.json$",
      "headers": {
        "Content-Type": "application/manifest+json; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/product/([^/?#]+)(?:/.*)?$",
      "dest": "/api/product-page?slug=$1"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": ".+"
        }
      ],
      "dest": "/api/product-page"
    },
    {
      "src": "^/((?!api/|downloads/|manifest\\.json|sw\\.js|pwa-.*\\.png|apple-touch-icon\\.png|icon\\.svg|index\\.html|assets/).+)$",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": ".+"
        }
      ],
      "dest": "/api/product-page"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/((?!api/|downloads/|manifest\\.json|sw\\.js|pwa-.*\\.png|apple-touch-icon\\.png|icon\\.svg|index\\.html|assets/|.*\\.(?:css|js|mjs|map|png|jpg|jpeg|webp|gif|svg|ico|woff|woff2|json|txt|apk)$).*)$",
      "dest": "/index.html"
    }
  ]
}
